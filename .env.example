# Copy this file to .env and adjust the values for your environment.

# Django
SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (leave DB_ENGINE empty / sqlite for local development)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# When ready to move to PostgreSQL, use something like:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=gerardos_bakery
# DB_USER=gerardos
# DB_PASSWORD=super-secret-password
# DB_HOST=localhost
# DB_PORT=5432

# Email (used for contact form / newsletter notifications, optional)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
